<resources>
    <!-- Dark window background so launch never flashes white before Compose draws. -->
    <style name="Theme.PortDeck" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/deck_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
